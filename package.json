{
  "name": "dsh-smart-model-failover",
  "version": "0.2.9",
  "description": "DeepSeek Harness 插件：模型请求失败时自动切换到下一个可用模型并续跑被打断的工作。运行时发现本 profile 所有已配置厂商、以及其他插件接入宿主的厂商模型；在「插件 → dsh-smart-model-failover」设置面板可配置总开关、模型调用顺序与厂商优先顺序。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "node --test test/",
    "prepublishOnly": "node scripts/preflight.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "failover",
    "model-failover",
    "llm",
    "provider",
    "resilience",
    "auto-retry"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "success-c (https://github.com/success-c)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/success-c/dsh-smart-model-failover.git"
  },
  "homepage": "https://github.com/success-c/dsh-smart-model-failover#readme",
  "bugs": {
    "url": "https://github.com/success-c/dsh-smart-model-failover/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
