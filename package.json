{
  "name": "dsh-smart-model-failover",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: when a model request fails, automatically switch to the next routable model discovered from every configured provider (and every externally connected one, e.g. WorkBuddy), then resume the interrupted turn.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "node --test test/",
    "prepublishOnly": "node scripts/preflight.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "failover",
    "model-failover",
    "llm",
    "provider",
    "resilience",
    "auto-retry"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "your-github-name (https://github.com/your-github-name)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-github-name/dsh-smart-model-failover.git"
  },
  "homepage": "https://github.com/your-github-name/dsh-smart-model-failover#readme",
  "bugs": {
    "url": "https://github.com/your-github-name/dsh-smart-model-failover/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
