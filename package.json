{
  "name": "dsh-smart-model-failover",
  "version": "0.2.6",
  "description": "DeepSeek Harness plugin: when a model request fails, automatically switch to the next routable model discovered from every provider registered with the host — including providers added by other plugins — then resume the interrupted turn. Configure it under Plugins → dsh-smart-model-failover (switch, model order, provider order).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "node --test test/",
    "prepublishOnly": "node scripts/preflight.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "failover",
    "model-failover",
    "llm",
    "provider",
    "resilience",
    "auto-retry"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "success-c (https://github.com/success-c)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/success-c/dsh-smart-model-failover.git"
  },
  "homepage": "https://github.com/success-c/dsh-smart-model-failover#readme",
  "bugs": {
    "url": "https://github.com/success-c/dsh-smart-model-failover/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
